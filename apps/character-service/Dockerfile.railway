FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace/apps/character-service
COPY apps/character-service/pom.xml .
COPY apps/character-service/src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/apps/character-service/target/character-service-0.1.0.jar /app/app.jar
EXPOSE 4192
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
