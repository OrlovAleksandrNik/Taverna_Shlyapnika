PORT=4192
SPRING_PROFILES_ACTIVE=prod

# Railway PostgreSQL exposes DATABASE_URL automatically when the database is connected.
# CHARACTER_DATABASE_URL and CHARACTER_DATABASE_JDBC_URL can override it when needed.
DATABASE_URL=
CHARACTER_DATABASE_URL=
CHARACTER_DATABASE_JDBC_URL=
CHARACTER_DATABASE_USERNAME=
CHARACTER_DATABASE_PASSWORD=

CHARACTER_CORS_ALLOWED_ORIGINS=https://your-site.example
CHARACTER_API_TOKEN=change-me-before-public-deploy
CHARACTER_SWAGGER_UI_ENABLED=false
