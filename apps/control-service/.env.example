CONTROL_DATABASE_URL=jdbc:postgresql://control-postgres:5432/taverna_control
CONTROL_DATABASE_USERNAME=control
CONTROL_DATABASE_PASSWORD=change-me-local-only

CONTROL_FRONTEND_ORIGIN=http://localhost:4191
CONTROL_PUBLIC_URL=http://localhost:4191

CONTROL_SESSION_SECRET=replace-with-random-session-secret
CONTROL_ENCRYPTION_KEY=replace-with-32-byte-minimum-secret

CONTROL_MAIL_PROVIDER=mock
CONTROL_MAIL_HOST=control-mail-dev
CONTROL_MAIL_PORT=1025
CONTROL_MAIL_USERNAME=
CONTROL_MAIL_PASSWORD=
CONTROL_MAIL_FROM=no-reply@taverna-control.local
CONTROL_MAIL_START_TLS=false

CONTROL_MEDIA_STORAGE_ROOT=/data/media
CONTROL_BACKUP_STORAGE_ROOT=/data/backups

CONTROL_BOOTSTRAP_OWNER_EMAIL=
CONTROL_BOOTSTRAP_TOKEN=

PUBLIC_REGISTRATION_ENABLED=false
CONTROL_MAIN_SITE_INTEGRATION_ENABLED=false
CONTROL_TELEGRAM_INTEGRATION_ENABLED=false
CONTROL_DESKTOP_AGENT_ENABLED=false
CONTROL_DESKTOP_AGENT_VOICEMOD_PATH=
CONTROL_DESKTOP_AGENT_SCREENSTAGE_PATH=
